# Keep paid AI disabled until a separate explicit activation and budget review.
ENABLE_PAID_AI=false
# Independent random secrets, at least 32 characters. Never commit actual values.
OPS_ADMIN_TOKEN=
CRON_SECRET=
DECK_BRIDGE_SECRET=
# Vercel Marketplace Upstash Free, eviction=false and autoUpgrade=false.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Dedicated Notion integration shared only with the report-parent page.
NOTION_REPORT_TOKEN=
NOTION_REPORT_PARENT_ID=
# Optional read-only source access. No repo write token is needed.
PROJECT_GITHUB_READ_TOKEN=
# Optional read-only eve MCP context, separate from deterministic report publishing.
NOTION_CONNECTOR_ENABLED=false
NOTION_CONNECTOR_ID=
# Local outbound relay and Obsidian pull only; never upload these paths or tokens.
CLOUD_OPS_URL=
COMMAND_DECK_URL=http://127.0.0.1:8788
COMMAND_DECK_TOKEN=
OBSIDIAN_VAULT=
